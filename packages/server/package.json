{
  "name": "@memoriae/server",
  "version": "0.1.0",
  "private": true,
  "description": "Server di MEMORIAE: API, database, controlli periodici, casi di attivazione",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "catalogo:da-ricontrollare": "tsx scripts/catalogo-da-ricontrollare.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@fastify/cookie": "11.1.5",
    "@memoriae/crypto": "0.1.0",
    "@simplewebauthn/server": "14.1.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  }
}
