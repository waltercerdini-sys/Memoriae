# Copia in .env e adatta. Il file .env non va mai nel repository.
NODE_ENV=development
PORT=3000
HOST=localhost
LOG_LEVEL=info
# Con docker compose:
DATABASE_URL=postgres://memoriae:memoriae@localhost:5432/memoriae
# Con Postgres.app sul Mac (utente = il tuo utente del Mac, senza password):
# DATABASE_URL=postgres://localhost:5432/memoriae
# E-mail in sviluppo: file + terminale (in produzione servirà SMTP)
# MAIL_OUTBOX=./data/posta.log

# Operatori che verificano le richieste di apertura (obbligatorio in produzione)
# OPERATOR_EMAILS=operatore@memoriae.ch

# Pagamenti: «prova» (nessun denaro) oppure «stripe» (TWINT e carte)
# PAYMENTS_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...     (avvisi su https://<dominio>/v1/pagamenti/avvisi)
# STRIPE_PRICE_ESSENZIALE=price_...   (CHF 59, annuale)
# STRIPE_PRICE_FAMIGLIA=price_...     (CHF 99, annuale)

# Invio vero delle e-mail (obbligatorio in produzione; in prova si imposta con  npm run posta)
# SMTP_HOST=mail.infomaniak.com
# SMTP_PORT=465
# SMTP_USER=info@memoriae.ch
# SMTP_PASSWORD=...
# MAIL_FROM=MEMORIAE <info@memoriae.ch>
