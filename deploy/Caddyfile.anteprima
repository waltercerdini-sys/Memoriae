# Anteprima: come la produzione, ma app e sito chiedono nome e password (file anteprima.caddy)
# finché MEMORIAE non è pronta per il pubblico.
{
	email {$CADDY_EMAIL}
}

(sicurezza) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

{$APP_DOMINIO} {
	import sicurezza
	# Nome e password solo sulle pagine: Safari non li manda con i file dell'app (script) né con
	# le chiamate al server, e la pagina resterebbe bianca. I file dell'app non sono segreti.
	handle /v1/* {
		reverse_proxy app:3000
	}
	handle /assets/* {
		root * /srv/app
		file_server
	}
	# Icone che Safari chiede da solo: senza nome e password, altrimenti ripropone la finestra.
	handle /favicon.ico /apple-touch-icon* /robots.txt {
		respond 404
	}
	handle {
		import /etc/caddy/anteprima.caddy
		root * /srv/app
		try_files {path} /index.html
		file_server
	}
}

www.{$SITO_DOMINIO} {
	redir https://{$SITO_DOMINIO}{uri} permanent
}

{$SITO_DOMINIO} {
	import sicurezza
	handle /assets/* {
		root * /srv/sito
		file_server
	}
	handle /favicon.ico /apple-touch-icon* /robots.txt {
		respond 404
	}
	handle {
		import /etc/caddy/anteprima.caddy
		root * /srv/sito
		try_files {path} {path}.html
		file_server
	}
}
